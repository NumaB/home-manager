# Local PostgreSQL (docker compose)
DATABASE_URL=postgresql://home_manager@localhost:5432/home_manager?schema=public

# Local API and web ports
API_PORT=3001
WEB_PORT=3000

# Clerk authentication: in local development, the API reads CLERK_SECRET_KEY from
# the ignored apps/web/.env.local created by `clerk init` / `clerk env pull`.
# In hosted environments, inject CLERK_SECRET_KEY as a secret instead.
WEB_ORIGINS=http://localhost:3000
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
