  "info": {
    "title": "Doz Manager API",
    "description": "API REST de Doz Manager",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "clerk-session": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CurrentMemberResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "USER",
              "ADMIN"
            ]
          },
          "isActive": {
            "type": "boolean"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "role",
          "isActive",
          "displayName"
        ]
      },
      "ReservationCreatorDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "displayName"
        ]
      },
      "ReservationResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "example": "2026-10-28",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "example": "2026-10-30",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "APPROVED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "creator": {
            "$ref": "#/components/schemas/ReservationCreatorDto"
          },
          "approvals": {
            "type": "number",
            "minimum": 0
          },
          "rejections": {
            "type": "number",
            "minimum": 0
          },
          "totalEligibleVoters": {
            "type": "number",
            "minimum": 0
          },
          "currentMemberVote": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REJECT"
            ],
            "nullable": true
          }
        },
        "required": [
          "id",
          "startDate",
          "endDate",
          "status",
          "createdAt",
          "creator",
          "approvals",
          "rejections",
          "totalEligibleVoters",
          "currentMemberVote"
        ]
      },
      "ReservationDatesDto": {
        "type": "object",
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "startDate",
          "endDate"
        ]
      },
      "ReservationVoteDto": {
        "type": "object",
        "properties": {
          "choice": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REJECT"
            ]
          }
        },
        "required": [
          "choice"
        ]
      }
    }
  }
}
