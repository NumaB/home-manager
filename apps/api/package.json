{
  "name": "@home-manager/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.build.json src/main.ts",
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "start:prod": "node dist/main.js",
    "typecheck": "pnpm db:generate && tsc --noEmit -p tsconfig.build.json",
    "test": "tsx --tsconfig tsconfig.build.json --test src/health/health.controller.spec.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "17.2.3",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
